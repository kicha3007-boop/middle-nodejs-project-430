    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc",
    "contract": "tsp compile contract"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@hexlet/js-flight-booking-frontend": "^1.0.1",
    "fastify": "^5.12.7",
