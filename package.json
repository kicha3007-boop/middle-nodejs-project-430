{
  "name": "flight-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Бекенд сервиса бронирования авиабилетов: API по контракту и раздача готового фронтенда",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
